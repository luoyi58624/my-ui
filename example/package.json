{
  "name": "@my-ui/example",
  "private": true,
  "type": "module",
  "description": "my-ui 的 Vue 展示页与原生 HTML 示例",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "dev:desktop": "tauri dev",
    "dev:android": "tauri android dev",
    "dev:test": "vite --mode test --host 127.0.0.1 --port 5179 --strictPort",
    "build": "vite build",
    "build:desktop": "tauri build --no-bundle",
    "build:android": "tauri android build --apk --target aarch64",
    "tauri": "tauri",
    "preview": "vite preview --host 127.0.0.1 --port 4178 --strictPort"
  },
  "dependencies": {
    "@my-ui/vue": "workspace:*",
    "@tauri-apps/plugin-store": "2.5.0",
    "@wdns/vue-code-block": "2.4.1",
    "highlight.js": "11.12.0",
    "pinia": "4.1.0",
    "tauri-plugin-android-system-font-weight": "file:../../../tauri/plugins/tauri-plugin-android-system-font-weight",
    "tauri-plugin-native-components": "file:../../../tauri/plugins/tauri-plugin-native-components",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3"
  }
}
