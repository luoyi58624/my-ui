{
  "name": "my-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "my-ui：可直接复制修改的 CSS + JavaScript 组件，附 Vue 3、React 薄封装与示例",
  "packageManager": "bun@1.3.8",
  "workspaces": ["packages/vue", "packages/react", "example"],
  "scripts": {
    "dev": "bun run --cwd example dev",
    "dev:desktop": "bun run --cwd example dev:desktop",
    "dev:android": "bun run --cwd example dev:android",
    "dev:test": "bun run --cwd example dev:test",
    "build": "bun run check && bun run --cwd example build && bun scripts/copy-native.mjs",
    "build:desktop": "bun run --cwd example build:desktop",
    "build:android": "bun run --cwd example build:android",
    "install:android": "node scripts/install-android.mjs",
    "preview": "bun run --cwd example preview",
    "check": "vue-tsc --noEmit && bun run check:lib && bun run check:react",
    "check:lib": "tsc --project tsconfig.lib.json",
    "check:react": "tsc --project tsconfig.react.json",
    "test:browser": "node scripts/test-browser.mjs",
    "test:state": "bun test ./tests/shared-state.test.ts ./tests/shared-state-tauri.test.ts ./tests/theme-state.test.ts",
    "test:theme": "bun test ./tests/theme.test.mjs",
    "test:components": "bun test ./tests/components.test.mjs",
    "test:popup": "bun test ./tests/popup.test.mjs",
    "test:floating": "bun test ./tests/floating.test.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-vue": "6.0.10",
    "pinia": "4.1.0",
    "playwright": "1.62.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue": "3.5.43",
    "vue-tsc": "3.3.13"
  }
}
