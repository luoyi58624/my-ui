{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": [
    "packages/vue/**/*.ts",
    "packages/react/**/*.ts",
    "packages/react/**/*.tsx",
    "examples/vue/src/**/*.ts",
    "examples/vue/src/**/*.vue",
    "examples/vue/vite.config.ts",
    "examples/react/react.tsx",
    "examples/react/vite.config.ts",
    "tests/react.fixture.tsx",
    "tests/react-types.tsx",
    "tests/vue-types.vue"
  ]
}
