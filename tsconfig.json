{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["packages/vue/**/*.ts", "packages/vue/**/*.vue", "example/src/**/*.ts", "example/src/**/*.vue", "example/vite.config.ts"]
}
